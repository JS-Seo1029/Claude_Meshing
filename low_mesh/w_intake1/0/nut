FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet_air
    {
        type            calculated;
        value           $internalField;
    }

    inlet_gas
    {
        type            calculated;
        value           $internalField;
    }

    "(fluid:1|gap1|wall1|wall2|inlet_air_path|inlet_gas_path|inlet_air_wall|inlet_gas_wall|inlet_air_sep_path|inlet_gas_sep_path)"
    {
        type            nutkWallFunction;
        Cmu             0.09;
        kappa           0.41;
        E               9.8;
        value           $internalField;
    }

    outlet
    {
        type            calculated;
        value           $internalField;
    }
}

