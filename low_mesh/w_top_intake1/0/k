FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 30;

boundaryField
{
    inlet_air
    {
        type            zeroGradient;
    }

    inlet_gas
    {
        type            zeroGradient;
    }

    "(fluid:1|gap1|wall1|wall2|inlet_air_path|inlet_gas_path|inlet_air_wall|inlet_gas_wall|inlet_air_sep_path|inlet_gas_sep_path)"
    {
        type            kqRWallFunction;
        value           uniform 30;
    }

    outlet
    {
        type            zeroGradient;
    }

}


