FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 30000;

boundaryField
{
    inlet_air
    {
        type            zeroGradient;
    }

    inlet_gas
    {
        type            zeroGradient;
    }

    "(fluid:1|gap1|wall1|wall2|inlet_air_path|inlet_gas_path|inlet_air_wall|inlet_gas_wall|inlet_air_sep_path|inlet_gas_sep_path)"
    {
        type            epsilonWallFunction;
        Cmu             0.09;
        kappa           0.41;
        E               9.8;
        value           uniform 50;
    }

    outlet
    {
        type            zeroGradient;
    }
}


