FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet_air
    {
        type            surfaceNormalFixedValue;
        refValue        uniform -10;
    }
    
    inlet_gas
    {
        type            surfaceNormalFixedValue;
        refValue        uniform -10;
    }
    
    "(fluid:1|gap1|wall1|wall2|inlet_air_path|inlet_gas_path|inlet_air_wall|inlet_gas_wall|inlet_air_sep_path|inlet_gas_sep_path)"
    {
        type            noSlip;
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           $internalField;
    }
}

