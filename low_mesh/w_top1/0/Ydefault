FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Ydefault;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet_air
    {
        type            fixedValue;
        value           uniform 0.0;
    }

    inlet_gas
    {
        type            fixedValue;
        value           uniform 0;
    }

    outlet
    {
        type            zeroGradient;
    }

    "(clearance|inlet_wall|gap1|wall1|wall2|wall3|center_top|right_top|left_top|center_bottom)"
    {
        type            zeroGradient;
    }


    ".*_AMI"
    {
        type            cyclicAMI;
    }
}

