FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alphat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet_air
    {
        type            calculated;
        value           $internalField;
    }

    inlet_gas
    {
        type            calculated;
        value           $internalField;
    }

    outlet
    {
        type            calculated;
        value           $internalField;
    }

    "(clearance|inlet_wall|gap1|wall1|wall2|wall3|center_top|right_top|left_top|center_bottom)"
    {
        type            calculated;
        value           $internalField;
    }

    ".*_AMI"
    {
        type            cyclicAMI;
    }
}

