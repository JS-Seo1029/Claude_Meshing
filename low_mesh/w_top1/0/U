FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet_air
    {   
        type            fixedValue;
        value           uniform (0 0 10);
    }
    
    inlet_gas
    {   
        type            fixedValue;
        value           uniform (0 0 10);
    }
    
    "(clearance|inlet_wall|gap1|wall1|wall2|wall3|center_top|right_top|left_top|center_bottom)"
    {
        type            noSlip;
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           $internalField;
    }

    ".*_AMI"
    {
        type            cyclicAMI;
    }
}

