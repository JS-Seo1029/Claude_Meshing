FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    inlet_air
    {
        type            zeroGradient;
    }

    inlet_gas
    {
        type            zeroGradient;
    }

    "(clearance|inlet_wall|gap1|wall1|wall2|wall3|center_top|right_top|left_top|center_bottom)"
    {
        type            zeroGradient;
    }

    outlet
    {
        type            totalPressure;
        rho             rho;
        psi             none;
        gamma           1;
        p0              uniform 101325;
        value           uniform 101325;
    }


    ".*_AMI"
    {
        type            cyclicAMI;
    }
}


