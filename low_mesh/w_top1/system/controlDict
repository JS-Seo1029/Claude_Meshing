FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     rhoReactingBuoyantFoam_log;

startFrom       latestTime;

startTime       0;

//stopAt          noWriteNow;
stopAt          endTime;

endTime         1.0; // 10.0; //45000; //40000;

deltaT          1.0e-5; //1e-5; //5e-6; //1e-5; //2.5e-5;

writeControl    adjustableRunTime;

writeInterval   0.1; //0.01; //500;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

adjustTimeStep  yes;

maxCo		0.8;

runTimeModifiable true;

functions
{
