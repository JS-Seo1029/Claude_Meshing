FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    top.stl
    {
        type triSurfaceMesh;
        name top;
        regions
        {
            center_top    { name center_top; }
            right_top     { name right_top; }
            left_top      { name left_top; }
            wall3         { name wall3; }
            outlet        { name outlet; }
            top_interface { name top_interface; }
            center_bottom { name center_bottom; }
        }
    }
    BOI      // body of influence from w_top.scdoc (around the floor plane z = 16.82)
    {
        type searchableBox;
        min (-20.0152878 -3.5251123 16.52);
        max ( -0.0152878  6.4748877 17.12);
    }
}

castellatedMeshControls
{
    maxLocalCells       5000000;
    maxGlobalCells      20000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;
    features ( { file "top.eMesh"; level 1; } );
    refinementSurfaces
    {
        top
        {
            level (1 1);
            patchInfo { type wall; }
            regions
            {
                outlet        { level (1 1); patchInfo { type patch; } }
                top_interface { level (1 1); patchInfo { type patch; } }
            }
        }
    }
    resolveFeatureAngle 30;
    refinementRegions
    {
        BOI { mode inside; levels ((1e15 1)); }
    }
    locationInMesh (-8.755 1.475 17.5);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      50;
    nRelaxIter      5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap true;
}

addLayersControls
{
    relativeSizes true;
    layers
    {
        "(center_top|right_top|left_top|center_bottom|wall3)" { nSurfaceLayers 3; }
    }
    expansionRatio      1.2;
    finalLayerThickness 0.4;
    minThickness        0.1;
    nGrow               0;
    featureAngle        60;
    slipFeatureAngle    30;
    nRelaxIter          3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedianAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
}

meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 4;
    maxInternalSkewness 3.5;
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       1e-15;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.05;
    minVolRatio         0.01;
    minTriangleTwist    -1;
    nSmoothScale        4;
    errorReduction      0.75;
    relaxed { maxNonOrtho 75; }
}

mergeTolerance 1e-6;
